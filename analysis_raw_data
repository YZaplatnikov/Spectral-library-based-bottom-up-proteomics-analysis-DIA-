cat > run_diann_publication_analysis_mzML.sh <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

echo "======================================================"
echo " DIA-NN publication-style analysis"
echo " Dataset: PXD062423"
echo " Input: mzML files"
echo "======================================================"

# Project root
PROJECT_ROOT="$HOME"
cd "$PROJECT_ROOT"

# DIA-NN Docker image
DIANN_IMAGE="diann:latest"
THREADS="${THREADS:-8}"

# Converted mzML folder
MZML_DIR="data_prot/PXD062423_mzML"

# Spectral libraries
LIB_DIR="results/diann/libraries"

HUMAN_LIB="${LIB_DIR}/human_swissprot.predicted.predicted.speclib"
HUMAN_ECOLI_LIB="${LIB_DIR}/human_ecoli_swissprot.predicted.predicted.speclib"

# FASTA files
FASTA_DIR="fasta"
HUMAN_FASTA="${FASTA_DIR}/human_swissprot_reviewed.fasta"
HUMAN_ECOLI_FASTA="${FASTA_DIR}/human_ecoli_swissprot_reviewed.fasta"

# Output folders
OUT_DIR="results/diann/publication_style_mzML"
POOLED_OUT_DIR="${OUT_DIR}/pooled_tear_human"
DILUTION_OUT_DIR="${OUT_DIR}/dilution_human_ecoli"

mkdir -p "$POOLED_OUT_DIR"
mkdir -p "$DILUTION_OUT_DIR"

echo ""
echo "Project root:"
echo "$PROJECT_ROOT"

echo ""
echo "Checking DIA-NN Docker image..."

if ! docker image inspect "$DIANN_IMAGE" > /dev/null 2>&1; then
  echo "ERROR: Docker image not found:"
  echo "$DIANN_IMAGE"
  exit 1
fi

echo "Docker image found:"
echo "$DIANN_IMAGE"

echo ""
echo "Finding DIA-NN executable inside Docker image..."

DIANN_BIN=$(docker run --rm --entrypoint /bin/sh "$DIANN_IMAGE" -c 'find / -type f -name "diann-linux" 2>/dev/null | head -n 1')

if [ -z "$DIANN_BIN" ]; then
  echo "ERROR: Could not find diann-linux inside Docker image."
  exit 1
fi

echo "DIA-NN executable found:"
echo "$DIANN_BIN"

echo ""
echo "Checking required library and FASTA files..."

for FILE in \
  "$HUMAN_LIB" \
  "$HUMAN_ECOLI_LIB" \
  "$HUMAN_FASTA" \
  "$HUMAN_ECOLI_FASTA"
do
  if [ ! -f "$FILE" ]; then
    echo "ERROR: Required file not found:"
    echo "$PROJECT_ROOT/$FILE"
    exit 1
  fi
done

echo "Required files found."

echo ""
echo "Using libraries:"
echo "  Human-only:      $HUMAN_LIB"
echo "  Human + E. coli: $HUMAN_ECOLI_LIB"

POOLED_FILES=(
  "Pool_DIA_R1.mzML"
  "Pool_DIA_R2.mzML"
  "Pool_DIA_R3.mzML"
  "Pool_DIA_R4.mzML"
  "Pool_DIA_R5.mzML"
  "Pool_DIA_R6.mzML"
  "Pool_DIA_R7.mzML"
  "Pool_DIA_R8.mzML"
)

DILUTION_FILES=(
  "DIA_Base_1.mzML"
  "DIA_Base_2.mzML"
  "DIA_Base_3.mzML"
  "DIA_2X_1.mzML"
  "DIA_2X_2.mzML"
  "DIA_2X_3.mzML"
  "DIA_4X_1.mzML"
  "DIA_4X_2.mzML"
  "DIA_4X_3.mzML"
  "DIA_8X_1.mzML"
  "DIA_8X_2.mzML"
  "DIA_8X_3.mzML"
)

echo ""
echo "Checking mzML files..."

for FILE in "${POOLED_FILES[@]}" "${DILUTION_FILES[@]}"
do
  if [ ! -f "${MZML_DIR}/${FILE}" ]; then
    echo "ERROR: mzML file not found:"
    echo "$PROJECT_ROOT/${MZML_DIR}/${FILE}"
    exit 1
  fi
done

echo "mzML files found."

COMMON_DIANN_ARGS=(
  --threads "$THREADS"
  --qvalue 0.01
  --matrices
  --pg-level 2
  --reanalyse
  --cut "K*,R*,!*P"
  --missed-cleavages 1
  --met-excision
  --fixed-mod Carbamidomethyl,57.021464,C
  --var-mod Oxidation,15.994915,M
  --var-mods 1
)

echo ""
echo "======================================================"
echo " 1/2 Running pooled tear-fluid DIA analysis"
echo "======================================================"

POOLED_DOCKER_FILES=()
for FILE in "${POOLED_FILES[@]}"
do
  POOLED_DOCKER_FILES+=(--f "/data/${MZML_DIR}/${FILE}")
done

docker run --rm \
  --entrypoint "$DIANN_BIN" \
  -v "$PROJECT_ROOT:/data" \
  "$DIANN_IMAGE" \
  "${POOLED_DOCKER_FILES[@]}" \
  --lib "/data/${HUMAN_LIB}" \
  --fasta "/data/${HUMAN_FASTA}" \
  --out "/data/${POOLED_OUT_DIR}/pooled_tear_human_report.tsv" \
  "${COMMON_DIANN_ARGS[@]}" \
  2>&1 | tee "${POOLED_OUT_DIR}/pooled_tear_human_console.log"

echo ""
echo "======================================================"
echo " 2/2 Running dilution / E. coli spike-in DIA analysis"
echo "======================================================"

DILUTION_DOCKER_FILES=()
for FILE in "${DILUTION_FILES[@]}"
do
  DILUTION_DOCKER_FILES+=(--f "/data/${MZML_DIR}/${FILE}")
done

docker run --rm \
  --entrypoint "$DIANN_BIN" \
  -v "$PROJECT_ROOT:/data" \
  "$DIANN_IMAGE" \
  "${DILUTION_DOCKER_FILES[@]}" \
  --lib "/data/${HUMAN_ECOLI_LIB}" \
  --fasta "/data/${HUMAN_ECOLI_FASTA}" \
  --out "/data/${DILUTION_OUT_DIR}/dilution_human_ecoli_report.tsv" \
  "${COMMON_DIANN_ARGS[@]}" \
  2>&1 | tee "${DILUTION_OUT_DIR}/dilution_human_ecoli_console.log"

echo ""
echo "======================================================"
echo " DIA-NN mzML analysis finished"
echo "======================================================"

echo ""
echo "Generated files:"
find "$OUT_DIR" -maxdepth 3 -type f | sort
EOF

chmod +x run_diann_publication_analysis_mzML.sh
./run_diann_publication_analysis_mzML.sh
