#!/usr/bin/env bash
set -euo pipefail

# =========================
# EDIT THESE PATHS
# =========================
DIANN="/path/to/diann/diann.exe"
RAW_DIR="/path/to/your/raw_files"
OUT_DIR="/path/to/your/results"
FASTA="/path/to/human_swissprot_reviewed.fasta"

mkdir -p "${OUT_DIR}"

# =========================
# 1. Generate predicted spectral library from FASTA
# =========================
"${DIANN}" \
  --fasta "${FASTA}" \
  --gen-spec-lib \
  --out-lib "${OUT_DIR}/human_predicted_lib.tsv" \
  --threads 8 \
  --enzyme "Trypsin/P" \
  --missed-cleavages 1 \
  --met-excision \
  --fixed-mod "Carbamidomethyl,C"

# =========================
# 2. Analyse pooled DIA runs
# =========================
"${DIANN}" \
  --f "${RAW_DIR}/Pool_DIA_R1.raw" \
  --f "${RAW_DIR}/Pool_DIA_R2.raw" \
  --f "${RAW_DIR}/Pool_DIA_R3.raw" \
  --f "${RAW_DIR}/Pool_DIA_R4.raw" \
  --f "${RAW_DIR}/Pool_DIA_R5.raw" \
  --f "${RAW_DIR}/Pool_DIA_R6.raw" \
  --f "${RAW_DIR}/Pool_DIA_R7.raw" \
  --f "${RAW_DIR}/Pool_DIA_R8.raw" \
  --lib "${OUT_DIR}/human_predicted_lib.tsv" \
  --out "${OUT_DIR}/Pool_DIA_report.tsv" \
  --qvalue 0.01 \
  --matrix-qvalue 0.01 \
  --threads 8 \
  --matrices \
  --mbr \
  --no-shared-spectra \
  --heuristic-protein-inference \
  --quant-ums \
  --protein-inference "gene"
